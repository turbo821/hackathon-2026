{
  "openapi": "3.1.0",
  "info": {
    "title": "Invoice Keeper API",
    "description": "Напоминания о регулярных платежах. Все эндпоинты — под префиксом `/api/v1`. Авторизация: получите токен в `POST /api/v1/auth/login` и нажмите **Authorize** (вставьте access_token).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Вход по логину и паролю",
        "description": "Возвращает JWT. Дальше передавайте его в заголовке `Authorization: Bearer <token>`.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenOut"
                }
              }
            }
          },
          "401": {
            "description": "Неверный логин или пароль"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Получение текущего пользователя",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Завершение текущей сессии",
        "description": "Токен попадает в список отозванных и больше не принимается.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/recurring-payments": {
      "get": {
        "tags": [
          "recurring-payments"
        ],
        "summary": "Получение списка регулярных платежей",
        "description": "По умолчанию только активные. `include_inactive=true` — вместе с прекращёнными.\n\nЧитается одна таблица: периоды хранят слепок полей платежа, поэтому\nподтягивать их здесь не нужно.",
        "operationId": "list_payments_api_v1_recurring_payments_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "include_inactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Include Inactive"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecurringPaymentOut"
                  },
                  "title": "Response List Payments Api V1 Recurring Payments Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "recurring-payments"
        ],
        "summary": "Создание регулярного платежа",
        "description": "Сразу создаются периоды. Если срок ближайшей оплаты ближе, чем через 3 дня,\nнапоминание в Telegram отправляется сразу.",
        "operationId": "create_payment_api_v1_recurring_payments_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecurringPaymentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecurringPaymentOut"
                }
              }
            }
          },
          "403": {
            "description": "Только администратор"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recurring-payments/{payment_id}": {
      "delete": {
        "tags": [
          "recurring-payments"
        ],
        "summary": "Прекращение регулярного платежа и его напоминаний с сохранением истории",
        "description": "Платёж помечается неактивным: новые периоды и напоминания больше не создаются.\nОплаченные и уже наступившие периоды остаются в истории;\nбудущие неоплаченные периоды удаляются.",
        "operationId": "delete_payment_api_v1_recurring_payments__payment_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "payment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Payment Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "Только администратор"
          },
          "404": {
            "description": "Платёж не найден"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payment-occurrences": {
      "get": {
        "tags": [
          "payment-occurrences"
        ],
        "summary": "Получение списка платежей, оплаченные и просроченные",
        "description": "Каждый элемент — конкретный период регулярного платежа со своим сроком и статусом.\n\nПериод хранит слепок полей платежа, поэтому список читается по одной таблице.",
        "operationId": "list_occurrences_api_v1_payment_occurrences_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "pending",
                    "overdue",
                    "paid",
                    "paid_late",
                    "unpaid_all"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "pending / overdue / paid / paid_late / unpaid_all (= pending + overdue)",
              "title": "State"
            },
            "description": "pending / overdue / paid / paid_late / unpaid_all (= pending + overdue)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "paid",
                    "unpaid"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "RUB",
                    "USD",
                    "EUR"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Currency"
            }
          },
          {
            "name": "recurring_payment_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Recurring Payment Id"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Срок оплаты с (включительно)",
              "title": "Date From"
            },
            "description": "Срок оплаты с (включительно)"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Срок оплаты по (включительно)",
              "title": "Date To"
            },
            "description": "Срок оплаты по (включительно)"
          },
          {
            "name": "include_inactive",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Включать периоды прекращённых платежей",
              "default": true,
              "title": "Include Inactive"
            },
            "description": "Включать периоды прекращённых платежей"
          },
          {
            "name": "include_future",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Включать ещё не наступившие периоды",
              "default": true,
              "title": "Include Future"
            },
            "description": "Включать ещё не наступившие периоды"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "asc",
                "desc"
              ],
              "type": "string",
              "default": "asc",
              "title": "Order"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OccurrenceOut"
                  },
                  "title": "Response List Occurrences Api V1 Payment Occurrences Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/payment-occurrences/{occurrence_id}": {
      "get": {
        "tags": [
          "payment-occurrences"
        ],
        "summary": "Получение конкретного платежа",
        "operationId": "get_occurrence_api_v1_payment_occurrences__occurrence_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
