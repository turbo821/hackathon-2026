# --- Backend ---
# SQLite-файл backend/instance/app.db (создаётся при первом запуске)
DATABASE_URL=sqlite:///./instance/app.db

# Секрет для подписи JWT — замените на случайную строку (openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-your-own-random-string

# Администратор. Задаётся только здесь: через панель его не изменить и не удалить.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
SUPERADMIN_EMAIL=superadmin@example.com


# Единый часовой пояс приложения: «сегодня», просрочка и напоминания считаются в нём
APP_TIMEZONE=Europe/Moscow

# Telegram-напоминания (токен и чат из @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
# Чат, в который пользователи вступают по ссылке с сайта.
# Бот должен быть в нём администратором с правом can_invite_users.
TELEGRAM_GROUP_CHAT_ID=
REMINDER_DAYS_BEFORE=3
REMINDER_CHECK_INTERVAL_SECONDS=60

# --- Email (SMTP) — рассылка напоминаний письмами ---
# Канал в разработке: пока SMTP_PASSWORD пустой, письма не отправляются.
# SMTP_ADDR — адрес вашего ящика, он же логин на почтовом сервере.
# Должен быть заполненным: пустое значение не проходит валидацию EmailStr.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_ADDR=you@example.com
SMTP_PASSWORD=
SMTP_NAME=Invoice Keeper
SMTP_SUBJECT=Напоминание об оплате
# STARTTLS вместо TLS на подключении: порт 587 вместо 465.
# У Mail.ru на 465 отказывает, на 587 работает.
SMTP_STARTTLS=false

# Тестовые данные (аренда/сервер/подписка) — можно отключить
SEED_DEMO_DATA=true

# CORS
CORS_ORIGINS=*

# --- Прокси для исходящих запросов ---
# Весь исходящий трафик контейнеров (backend, worker) идёт через xray:
# контейнеры -> xray (SOCKS5) -> интернет. Нужно там, где из контейнеров
# не достучаться напрямую: IPv4 к Cloudflare закрыт, а у контейнеров нет IPv6.
#
# xray — обычный сервис в compose, доступен контейнерам по имени `xray`.
# Он резолвит домены сам и берёт только IPv4: иначе Telegram отдаёт
# IPv6-адрес, который дальше по цепочке отклоняется (socks5 code=4).
#
# Если на сервере поднят Cloudflare WARP в режиме туннеля, трафик
# контейнеров уходит на хост и дальше в туннель WARP:
#   warp-cli --accept-tos mode warp && warp-cli --accept-tos connect
#
# Адрес прокси для сервисов. Пусто — работаем без прокси.
PROXY_URL=socks5://xray:1080

# Telegram Bot API — тот же прокси.
BOT_PROXY_URL=socks5://xray:1080

# --- Логирование ---
# Уровень: DEBUG, INFO, WARNING, ERROR. DEBUG показывает SQL-запросы — шумно.
LOG_LEVEL=INFO
# Формат записей: text (человекочитаемо) или json (одна строка JSON на запись).
# Для сервера удобнее json — логи можно парсить и искать по полям.
LOG_FORMAT=text
# Уровень для сторонних библиотек (uvicorn, httpx, sqlalchemy).
# WARNING — только проблемы, без рутины.
LOG_LEVEL_LIBRARIES=WARNING

# --- Frontend ---
# Адрес API для браузера. Относительный — запрос идёт на тот же origin,
# где открыта страница, а dev-сервер Vite проксирует /api в бэкенд.
# Абсолютный адрес (http://<домен>:5000/api/v1) — если бэкенд доступен
# напрямую и CORS_ORIGINS разрешает домен панели.
VITE_API_URL=/api/v1
